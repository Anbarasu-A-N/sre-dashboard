# Optional: /etc/nginx/sites-available/sre-dashboard
# Use this if you want TLS (certbot) or a hostname instead of http://<ip>.
# If you use it, run the app on port 3000 (PORT=3000 in the systemd unit) and set
#   TRUST_PROXY=1      (so login throttling sees the real client IP)
#   COOKIE_SECURE=1    (once the site is served over HTTPS)

server {
    listen 80;
    server_name sre-dashboard.internal; # replace with your hostname

    client_max_body_size 30m;           # backup imports can be large

    # Live updates (server-sent events): must not be buffered or cut off after a minute.
    location /api/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;   # keep the port: the app compares Host with the browser's Origin
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
